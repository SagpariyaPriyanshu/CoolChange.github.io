PORT=3000
NODE_ENV=development

# Local PostGIS from docker compose (see backend/README.md).
# Host port is 5433 so it does not clash with a Homebrew Postgres on 5432.
DATABASE_URL=postgres://coolchange:coolchange@localhost:5433/coolchange

# true when connecting to a cloud DB (RDS); false for local Postgres/PostGIS
DATABASE_SSL=false
